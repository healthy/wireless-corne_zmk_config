#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* This block enables Lower + Raise = Max_Layer automatically */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp F             &kp P  &kp B        &kp J      &kp L  &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp TAB    &kp A  &kp R  &kp S             &kp T  &kp G        &kp M      &kp N  &kp E      &kp I    &kp O     &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C             &kp D  &kp V        &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp LGUI
                         &kp LEFT_CONTROL  &mo 1  &kp SPACE    &kp SPACE  &mo 2  &kp RALT
            >;
        };

        numb_layer {
            display-name = "Numb";
            bindings = <
&kp ESC  &kp N1   &kp N2             &kp N3            &kp N4       &kp N5       &msc SCRL_UP    &kp PG_UP  &kp UP    &kp HOME   &kp BSPC  &kp DEL
&trans   &kp N6   &kp N7             &kp N8            &kp N9       &kp N0       &msc SCRL_DOWN  &kp LEFT   &kp DOWN  &kp RIGHT  &trans    &trans
&trans   &kp DOT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp K_MUTE   &trans       &trans          &kp PG_DN  &trans    &kp END    &trans    &kp LEFT_GUI
                                     &trans            &trans       &kp ENTER    &kp RET         &trans     &kp RALT
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&trans      &kp LS(EXCL)   &kp LS(AT)    &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp BSPC      &kp DEL
&trans      &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)  &kp LS(RPAR)     &kp LS(UNDER)  &kp LS(PLUS)  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PIPE)  &kp LS(TILDE)
&bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4     &kp MINUS      &kp EQUAL     &kp LBKT      &kp RBKT      &kp BSLH      &kp GRAVE
                                         &kp LGUI       &trans        &kp RET          &kp RET        &trans        &kp RALT
            >;
        };

        func_Layer {
            display-name = "Func";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &msc SCRL_UP
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &msc SCRL_DOWN
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        /* These "Reserved" layers bypass the Kconfig error by forcing memory allocation */
        reserved_4 {
            status = "reserved";
        };

        reserved_5 {
            status = "reserved";
        };
    };
};
