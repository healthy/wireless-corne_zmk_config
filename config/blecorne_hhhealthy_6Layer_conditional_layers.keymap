#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* This block enables Lower + Raise = Max_Layer automatically */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Colmak";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp F             &kp P  &kp B        &kp J      &kp L  &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp TAB    &kp A  &kp R  &kp S             &kp T  &kp G        &kp M      &kp N  &kp E      &kp I    &kp O     &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C             &kp D  &kp V        &kp K      &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp LGUI
                         &kp LEFT_CONTROL  &mo 3  &kp SPACE    &kp SPACE  &mo 4  &kp RALT
            >;
        };

        qwerty_layer {
            display-name = "Qwerty";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E             &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D             &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C             &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LGUI
                         &kp LEFT_CONTROL  &mo 3  &kp SPACE    &kp SPACE  &mo 4  &tog 1
            >;
        };
		
		gaming_layer {
            display-name = "Gaming";
            bindings = <
&kp N1     &kp Q  &kp W  &kp E             &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp N2     &kp A  &kp S  &kp D             &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C             &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LGUI
                         &kp LEFT_CONTROL  &mo 3  &kp SPACE    &kp SPACE  &mo 4  &tog 2
            >;
        };
		
        numb_layer {
            display-name = "Numb";
            bindings = <
&kp ESC  &kp N1   &kp N2             &kp N3            &kp N4       &kp N5       &msc SCRL_UP    &kp PG_UP  &kp UP    &kp HOME   &kp BSPC  &kp DEL
&trans   &kp N6   &kp N7             &kp N8            &kp N9       &kp N0       &msc SCRL_DOWN  &kp LEFT   &kp DOWN  &kp RIGHT  &trans    &trans
&trans   &kp DOT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp K_MUTE   &kp BSPC     &trans          &kp PG_DN  &trans    &kp END    &trans    &kp LEFT_GUI
                                     &trans            &trans       &kp ENTER    &kp RET         &trans     &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp ESC     &kp LS(EXCL)   &kp LS(AT)    &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp BSPC      &kp DEL
&trans      &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)  &kp LS(RPAR)     &kp LS(UNDER)  &kp LS(PLUS)  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PIPE)  &kp LS(TILDE)
&bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4     &kp MINUS      &kp EQUAL     &kp LBKT      &kp RBKT      &kp BSLH      &kp GRAVE
                                         &kp LGUI       &trans        &kp RET          &kp RET        &trans        &trans
            >;
        };

        func_Layer {
            display-name = "Func";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &msc SCRL_UP
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &msc SCRL_DOWN
                        &tog 2  &trans  &trans    &trans  &trans  &tog 1
            >;
        };
    };
};
